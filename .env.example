# ==============================================================================
# Sahil Nawaz Portfolio — Supabase PostgreSQL & Backend Configuration (.env.example)
# Copy this file to .env or backend/.env before running the backend.
# NEVER commit the actual .env file with real passwords to GitHub.
# ==============================================================================

# Supabase PostgreSQL Connection Credentials
# Obtain these from: Supabase Dashboard -> Project Settings -> Database -> Connection Info
SUPABASE_DB_HOST=aws-0-[REGION].pooler.supabase.com
SUPABASE_DB_PORT=5432
SUPABASE_DB_NAME=postgres
SUPABASE_DB_USER=postgres.[YOUR-PROJECT-REF]
SUPABASE_DB_PASSWORD=your_actual_supabase_db_password
PGSSLMODE=require

# Direct Connection String (Alternative / Session Pooler)
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres?sslmode=require

# Supabase REST API & Service Keys (Never expose service role key to frontend)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Flask Application Settings
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000
SECRET_KEY=sahil-portfolio-dev-secret-key-2026-production-ready
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5500,http://localhost:3000
ENABLE_HTTPS=false

# Email Notification Configuration (Gmail App Password for sahilnawaz257@gmail.com)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
NOTIFICATION_EMAIL=sahilnawaz257@gmail.com
