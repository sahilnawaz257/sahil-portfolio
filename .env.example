# ==============================================================================
# Sahil Nawaz Portfolio — Environment Configuration Example (.env.example)
# Copy this file to .env before deployment.
# NEVER commit the actual .env file to public version control.
# ==============================================================================

# Flask Environment & Execution Mode
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000

# Cryptographic Secret Key (Generate a random 32+ byte string in production)
SECRET_KEY=your-super-secret-random-key-change-in-production

# CORS Trusted Origins (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5500,http://localhost:3000

# Enforce Secure Cookies over HTTPS (Set to true in production deployments)
ENABLE_HTTPS=false

# ==============================================================================
# Supabase PostgreSQL Database Configuration
# Obtain these credentials from your Supabase Project Settings -> Database / API
# If left empty, the application seamlessly defaults to local SQLite fallback.
# ==============================================================================
# Option 1: Direct or Pooled Connection String (Recommended for Backend)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
# Or Transaction Pooler (port 6543):
# DATABASE_URL=postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?sslmode=require

# Option 2: Supabase REST API & Service Credentials (Server-Side Only)
SUPABASE_URL=https://[YOUR-PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
PGSSLMODE=require

# ==============================================================================
# Email Notification Configuration (SMTP for Contact & Meeting Alerts)
# Optional: If unconfigured, notifications are safely logged locally to DB & logs.
# ==============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
NOTIFICATION_EMAIL=sahilnawaz257@gmail.com
