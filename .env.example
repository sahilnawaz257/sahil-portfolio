# ==============================================================================
# Sahil Nawaz Portfolio — Supabase PostgreSQL & Backend Configuration (.env.example)
# Copy this file to .env or backend/.env before running the backend.
# NEVER commit the actual .env file with real passwords to GitHub.
# ==============================================================================

# Supabase Python SDK & Data API Configuration (PostgREST API)
# Enter your actual credentials from Supabase Dashboard -> Project Settings -> API
SUPABASE_URL=your_supabase_project_url
SUPABASE_PUBLISHABLE_KEY=your_publishable_key
SUPABASE_SECRET_KEY=your_new_rotated_secret_key

# Backward compatibility aliases for raw PostgreSQL connection (Step 3)
# SUPABASE_DB_HOST=aws-0-[REGION].pooler.supabase.com
# SUPABASE_DB_PORT=5432
# SUPABASE_DB_NAME=postgres
# SUPABASE_DB_USER=postgres.[YOUR-PROJECT-REF]
# SUPABASE_DB_PASSWORD=your_actual_supabase_db_password
# PGSSLMODE=require

# Flask Application Settings
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000
SECRET_KEY=sahil-portfolio-dev-secret-key-2026-production-ready
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5500,http://localhost:3000
ENABLE_HTTPS=false

# Email Notification Configuration (Gmail App Password for sahilnawaz257@gmail.com)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
NOTIFICATION_EMAIL=sahilnawaz257@gmail.com

# ==============================================================================
# Google Calendar & Google Meet API Integration (Optional / On-Demand)
# If unconfigured, the meeting request system remains 100% operational, and
# Sahil can manually attach any custom Google Meet link during approval.
# To automate Meet link generation:
# 1. Enable Google Calendar API in Google Cloud Console
# 2. Create a Service Account and download the JSON keyfile
# 3. Share your calendar with the service account email
# ==============================================================================
GOOGLE_SERVICE_ACCOUNT_FILE=path/to/service-account-key.json
GOOGLE_CALENDAR_ID=primary
