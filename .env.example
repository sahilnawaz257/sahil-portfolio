# ==============================================================================
# Sahil Nawaz Portfolio — Environment Configuration Example (.env.example)
# Copy this file to .env before deployment.
# NEVER commit the actual .env file to public version control.
# ==============================================================================

# Flask Environment & Execution Mode
FLASK_ENV=development
HOST=127.0.0.1
PORT=5000

# Cryptographic Secret Key (Generate a random 32+ byte string in production)
SECRET_KEY=your-super-secret-random-key-change-in-production

# CORS Trusted Origins (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://127.0.0.1:5000,http://localhost:5000,http://127.0.0.1:5500,http://localhost:3000

# Enforce Secure Cookies over HTTPS (Set to true in production deployments)
ENABLE_HTTPS=false

# ==============================================================================
# Email Notification Configuration (SMTP for Contact & Meeting Alerts)
# Optional: If unconfigured, notifications are safely logged locally to DB & logs.
# ==============================================================================
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-google-app-password
NOTIFICATION_EMAIL=sahilnawaz257@gmail.com

